# Normalize line endings in the repository; checkouts use the platform default.
* text=auto

# Source and docs: LF in the repository.
*.rs    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.svg   text eol=lf

# Windows scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never touched, never diffed.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.wasm  binary
*.tflite binary
*.zip   binary
*.gz    binary

# Generated/licence text is produced at build time; keep diffs readable.
public/legal/THIRD_PARTY_NOTICES.txt -diff linguist-generated=true
package-lock.json -diff linguist-generated=true
src-tauri/Cargo.lock -diff linguist-generated=true
